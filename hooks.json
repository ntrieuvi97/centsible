{
  "centsible": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "./bin/centsible hook pre-invocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./bin/centsible hook pre-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./bin/centsible hook post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./bin/centsible hook stop",
        "timeout": 5
      }
    ]
  }
}
